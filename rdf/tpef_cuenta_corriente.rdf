  <rdf:Description rdf:about="https://w3id.org/tpef/concepts/cuenta_corriente_remunerada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="es">cuenta corriente remunerada</skos:prefLabel>
    <skos:definition xml:lang="es">Modalidad de cuenta corriente que genera intereses 
        sobre el saldo mantenido.</skos:definition>
