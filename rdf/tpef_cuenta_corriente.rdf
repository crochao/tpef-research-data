  <rdf:Description rdf:about="https://w3id.org/tpef/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="es">Tesauro Panhispánico de Educación Financiera (TPEF)</rdfs:label>
    <rdfs:label xml:lang="en">Pan-Hispanic Financial Education Thesaurus (TPEF)</rdfs:label>
    <dcterms:creator>Carlos O. Rocha Ochoa</dcterms:creator>
    <dcterms:description xml:lang="en">Partial SKOS concept scheme illustrating diatopic 
        denominative variation in the pan-Hispanic financial education 
        thesaurus. Modelling example: cuenta corriente / cuenta de cheques.</dcterms:description>
    <dcterms:language>es</dcterms:language>
    <owl:versionInfo>0.1-example</owl:versionInfo>
  </rdf:Description>
