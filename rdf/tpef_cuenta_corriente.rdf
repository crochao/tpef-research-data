  <rdf:Description rdf:about="https://w3id.org/tpef/concepts/cuenta_corriente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="es">cuenta corriente</skos:prefLabel>
    <skos:altLabel xml:lang="es-MX">cuenta de cheques</skos:altLabel>
    <skos:altLabel xml:lang="es-CL">cuenta corriente bancaria</skos:altLabel>
    <skos:altLabel xml:lang="es-MX">cuenta corriente bancaria</skos:altLabel>
    <skos:definition xml:lang="es">Contrato entre una entidad financiera y una persona 
        natural o jurídica mediante el cual el titular deposita dinero 
        y puede disponer de él de forma inmediata, habitualmente a través 
        de cheques, tarjeta de débito o transferencias.</skos:definition>
    <skos:scopeNote xml:lang="es">'Cuenta de cheques' es la denominación característica 
        de los recursos mexicanos (PNIF). 'Cuenta corriente bancaria' 
        aparece en recursos chilenos (CMF, EST) y en BBVA México como 
        precisión técnica. El resto del corpus hispanohablante usa 
        'cuenta corriente' sin calificativo adicional.</skos:scopeNote>
    <skos:inScheme rdf:resource="https://w3id.org/tpef/concepts/EsquemaTPEF"/>
    <skos:broader rdf:resource="https://w3id.org/tpef/concepts/deposito_bancario"/>
    <skos:narrower rdf:resource="https://w3id.org/tpef/concepts/cuenta_corriente_remunerada"/>
    <skos:related rdf:resource="https://w3id.org/tpef/concepts/cheque"/>
    <skos:related rdf:resource="https://w3id.org/tpef/concepts/tarjeta_debito"/>
    <skos:related rdf:resource="https://w3id.org/tpef/concepts/cuenta_ahorro"/>
    <skos:related rdf:resource="https://w3id.org/tpef/concepts/sobregiro"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_AR_BBV"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_BO_BCB"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_CL_CMF"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_CL_EST"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_CO_SFC"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_EC_SBE"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_ES_FPT"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_MX_PNIF"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_PA_BGP"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_PY_BCP"/>
    <dcterms:source rdf:resource="https://w3id.org/tpef/concepts/glosario_SV_SSF"/>
  </rdf:Description>
