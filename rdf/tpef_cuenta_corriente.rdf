  <rdf:Description rdf:about="https://w3id.org/tpef/concepts/deposito_bancario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="es">depósito bancario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bank deposit</skos:prefLabel>
    <skos:definition xml:lang="es">Operación mediante la cual una persona entrega 
        fondos a una entidad financiera para su custodia y 
        administración.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/tpef/concepts/EsquemaTPEF"/>
    <skos:topConceptOf rdf:resource="https://w3id.org/tpef/concepts/EsquemaTPEF"/>
  </rdf:Description>
